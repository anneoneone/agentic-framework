{
  "folders": [
    {
      "name": "🤖 Agents (live-moafunk)",
      "path": ".github/agents"
    },
    {
      "name": "🦀 Backend (Rust/Axum)",
      "path": "source/backend"
    },
    {
      "name": "🎨 Frontend (Vue/Vite)",
      "path": "source/frontend"
    },
    {
      "name": "⚙️ Workflows",
      "path": "source/.github/workflows"
    },
    {
      "name": "📚 Stack (live-moafunk)",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/target": true,
      "**/.git": true,
      "**/.venv": true
    },
    "rust-analyzer.cargo.features": "all",
    "typescript.preferences.importModuleSpecifier": "relative",
    "editor.formatOnSave": true,
    "[rust]": {
      "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[vue]": {
      "editor.defaultFormatter": "Vue.volar"
    },
    "workbench.colorCustomizations": {
      "editor.background": "#1B1D1F",
      "editorIndentGuide.activeBackground1": "#FF8800",
      "activityBar.background": "#63000C",
      "titleBar.activeBackground": "#8A0011",
      "titleBar.activeForeground": "#FFFBFC",
      "titleBar.inactiveBackground": "#63000C",
      "titleBar.inactiveForeground": "#FFFBFC",
      "statusBar.background": "#63000C",
      "statusBar.foreground": "#FFFBFC",
      "statusBar.debuggingBackground": "#63000C",
      "statusBar.debuggingForeground": "#FFFBFC",
      "statusBar.noFolderBackground": "#63000C",
      "statusBar.noFolderForeground": "#FFFBFC"
    }
  },
  "extensions": {
    "recommendations": [
      "rust-lang.rust-analyzer",
      "Vue.volar",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "ms-azuretools.vscode-docker"
    ]
  }
}
