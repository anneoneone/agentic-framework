{
	"folders": [
		{
			"name": "📚 Copilot Agents Framework",
			"path": "."
		},
		{
			"name": "🤖 Agents (Framework)",
			"path": ".github/agents"
		},
		{
			"name": "📖 Documentation",
			"path": "docs"
		},
		{
			"name": "🏗️ Stacks",
			"path": "stacks"
		}
	],
	"settings": {
		"files.exclude": {
			"**/.git": true,
			"**/.DS_Store": true,
			"**/node_modules": true,
			"**/__pycache__": true,
			"**/.pytest_cache": true,
			"**/target": true,
			"**/.venv": true,
			"**/.archive": true
		},
		"search.exclude": {
			"**/node_modules": true,
			"**/.venv": true,
			"**/target": true,
			"**/.git": true
		},
		"github.copilot.chat.codeGeneration.instructions": [
			{
				"file": "README.md"
			}
		],
		"workbench.colorCustomizations": {
			"editor.background": "#1B1D1F",
			"editorIndentGuide.activeBackground1": "#FF8800",
			"activityBar.background": "#2E2A46",
			"titleBar.activeBackground": "#403B62",
			"titleBar.activeForeground": "#FBFBFC"
		}
	},
	"extensions": {
		"recommendations": [
			"github.copilot",
			"github.copilot-chat"
		]
	}
}
