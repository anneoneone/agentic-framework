{
  "folders": [
    {
      "name": "🤖 Agents (gartenroboter3000)",
      "path": ".github/agents"
    },
    {
      "name": "🌱 Gartenroboter3000",
      "path": "source"
    },
    {
      "name": "📚 Stack (gartenroboter3000)",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/.venv": true,
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/.mypy_cache": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder:🌱 Gartenroboter3000}/.venv/bin/python",
    "python.analysis.typeCheckingMode": "standard",
    "editor.formatOnSave": true,
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "workbench.colorCustomizations": {
      "editor.background": "#1B1D1F",
      "editorIndentGuide.activeBackground1": "#FF8800",
      "activityBar.background": "#501E16",
      "titleBar.activeBackground": "#702A1F",
      "titleBar.activeForeground": "#FDF9F8"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "github.copilot"
    ]
  }
}
