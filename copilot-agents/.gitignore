# .gitignore for copilot-agents framework
# Generated: 2026-01-20 by @meta-maintainer

# do not commit user-specific runtime files for copilot-agents framework
**/knowledge/

# =============================================================================
# Build Artifacts
# =============================================================================

# Rust
**/target/
**/*.rs.bk
**/Cargo.lock        # Only for libraries; apps should commit this

# Python
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# JavaScript/Node
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.npm
**/.yarn

# C/C++
**/*.o
**/*.a
**/*.out
**/*.exe

# =============================================================================
# IDE/Editor Settings (User-Specific)
# =============================================================================

# VS Code
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/.ropeproject

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*~
.*.sw?

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# Sublime Text
*.sublime-workspace
*.sublime-project

# =============================================================================
# OS Files
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# =============================================================================
# Logs and Temporary Files
# =============================================================================

*.log
*.tmp
*.temp
*.cache
.cache/

# =============================================================================
# Copilot Agents Runtime (User-Specific State)
# =============================================================================

# Active plan state - user-specific, regenerated per session
.copilot-agents/plans/

# Generated knowledge - user-specific analysis
.copilot-agents/knowledge/

# Cache directories
.copilot-agents/cache/
.copilot-agents/tmp/

# =============================================================================
# User-Specific Symlinks
# =============================================================================

# Each developer has their own monorepo clone path
# stacks/*/monorepo symlinks point to different locations per user
**/monorepo

# =============================================================================
# Archives and Backups
# =============================================================================

.archive/
*.bak
*.backup
*.old

# =============================================================================
# Test Coverage and Reports
# =============================================================================

coverage/
.coverage
htmlcov/
*.cover
.pytest_cache/
.tox/

# =============================================================================
# Environment Files (May Contain Secrets)
# =============================================================================

.env
.env.local
.env.*.local
*.pem
*.key
*.crt

# =============================================================================
# Framework-Specific Exceptions
# =============================================================================

# DO commit workspace files (they use relative paths)
!**/*.code-workspace

# DO commit agent files
!**/.github/agents/*.agent.md

# DO commit stack documentation
!**/docs/SHARED_KNOWLEDGE.md
!**/README.md
